{
  "name": "@modifier-calculator/vue",
  "version": "0.1.0",
  "description": "Game-agnostic modifier calculator for RPG systems with configurable stacking rules",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "rpg",
    "modifier",
    "calculator",
    "dice",
    "ttrpg",
    "dnd",
    "pathfinder",
    "game-agnostic"
  ],
  "author": "Logan <logan@phantasea.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakmaster/modifier-calculator.git"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^1.8.0"
  }
}
